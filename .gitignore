# Local-only archive, caches, audits, and build output
/.local/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Fallback output paths
/build/
/dist/
/release/
*.spec

# Temporary, test, and regression artifacts created outside .local
/.tmp*
/tmp/
/Extracted/
# Regression tests ARE tracked (audit F17): only their runtime output is ignored.
/.pytest_cache/
/test-results/
/playwright-report/
/qa-*.png
/screenshots/
/data/cache/
/data/source-audit.json
*.log
*.tmp
*.out

# Local configuration and editor files
.env
.env.*
!.env.example
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Native core build output
/native/wfcore/target/
/vendor/wfarsenal/wfcore.pyd
/vendor/wfarsenal/wfcore.so
/vendor/wfarsenal/wfcore.pyd.old-*
